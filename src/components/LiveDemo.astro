---
import Icon from './Icon.astro';

// variant: 'primary' (project page TL;DR) or 'secondary' (Home entries).
const { project, variant = 'secondary' } = Astro.props;
---

<a class={`btn btn-${variant}`} href={project.liveUrl} target="_blank" rel="noopener">
  Live demo<Icon name="external" size={14} /><span class="visually-hidden"> (opens in a new tab)</span>
</a>
