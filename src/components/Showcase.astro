---
// Screen recordings for projects that can't be shown live.
// Videos never autoplay and have controls. They have no sound, so each one carries a short
// text alternative for screen readers (visually hidden; the clip itself shows what happens).
const { showcase } = Astro.props;
const { clips = [] } = showcase;
---

<ol class="clips">
  {
    clips.map((clip, i) => (
      <li class="clip">
        <h2 class="clip-title">
          <span class="clip-number">{i + 1}</span>
          {clip.title}
        </h2>
        <video
          controls
          preload="metadata"
          playsinline
          muted
          poster={clip.poster}
          width="390"
          height="844"
          aria-describedby={`clip-${i}-description`}
        >
          <source src={clip.src} type="video/webm" />
        </video>
        <p id={`clip-${i}-description`} class="visually-hidden">{clip.description}</p>
      </li>
    ))
  }
</ol>

<style>
  .clips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .clip {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .clip-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 18px;
    font-stretch: 100%;
  }

  .clip-number {
    font-size: 15px;
    color: var(--accent);
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    box-sizing: border-box;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--tint);
  }

  @media (max-width: 599.98px) {
    .clips {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .clip {
      width: 100%;
      max-width: 300px;
    }
  }
</style>
