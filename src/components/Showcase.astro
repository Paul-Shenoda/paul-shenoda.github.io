---
import { Image } from 'astro:assets';

// Screen recordings (and optional stills) for projects that can't be shown live.
// Videos never autoplay, have controls, and each one is described in text (they have no audio).
const { showcase } = Astro.props;
const { clips = [], images = [] } = showcase;
---

<div class="showcase">
  <ol class="clips">
    {
      clips.map((clip, i) => (
        <li class="clip">
          <h2 class="clip-title">
            <span class="clip-number">{i + 1}</span>
            {clip.title}
          </h2>
          <p class="clip-change">
            <span class="visually-hidden">Before: </span>
            {clip.before}
            <span aria-hidden="true"> → </span>
            <span class="visually-hidden">. After: </span>
            <strong>{clip.after}</strong>
          </p>
          <video
            controls
            preload="metadata"
            playsinline
            muted
            poster={clip.poster}
            width="390"
            height="844"
            aria-describedby={`clip-${i}-description`}
          >
            <source src={clip.src} type="video/webm" />
          </video>
          <p id={`clip-${i}-description`} class="clip-description">{clip.description}</p>
        </li>
      ))
    }
  </ol>

  {
    images.map((image) => (
      <figure class="still">
        <Image src={image.src} alt={image.alt} widths={[640, 1280]} sizes="(max-width: 1023px) 100vw, 640px" />
        <figcaption>{image.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .showcase {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .clips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .clip {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 1.5px solid var(--ink);
  }

  .clip-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 22px;
    font-stretch: 100%;
  }

  .clip-number {
    font-size: 15px;
    font-weight: 700;
    color: var(--accent);
  }

  .clip p,
  figcaption {
    margin: 0;
  }

  .clip-change {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }

  .clip-change strong {
    color: var(--ink);
    font-weight: 600;
  }

  video,
  img {
    display: block;
    width: 100%;
    max-width: 320px;
    height: auto;
    box-sizing: border-box;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--tint);
  }

  .clip-description,
  figcaption {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .still {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1.5px solid var(--ink);
  }

  .still img {
    max-width: 100%;
  }

  @media (max-width: 599.98px) {
    .clips {
      grid-template-columns: minmax(0, 1fr);
    }

    video {
      max-width: 300px;
      margin: 0 auto;
    }
  }
</style>
