---
import LiveDemo from './LiveDemo.astro';
import Metrics from './Metrics.astro';

const { project } = Astro.props;
const href = `/projects/${project.slug}`;
---

<article class="entry">
  <div class="entry-head">
    <h3><a href={href}>{project.title}</a></h3>
    <p class="stack">{project.stack}</p>
  </div>
  <p class="outcome">{project.outcome}</p>
  <Metrics metrics={project.metrics} />
  <div class="actions">
    <a class="btn btn-primary" href={href}>Project details</a>
    {
      project.liveUrl ? (
        <LiveDemo project={project} />
      ) : (
        <a class="btn btn-secondary" href={`${href}#screens`}>See the screens</a>
      )
    }
  </div>
  <p class="demo-note">{project.demoNote}</p>
</article>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 0 32px;
    border-top: 1.5px solid var(--ink);
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  /* The padding gives the title link a 44px+ tap target; the negative margin keeps the layout. */
  h3 a {
    display: inline-block;
    padding: 10px 0;
    margin: -10px 0;
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  .entry p {
    margin: 0;
  }

  .stack {
    font-size: 14px;
    color: var(--muted);
  }

  .outcome {
    max-width: 62ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 4px;
  }

  .demo-note {
    font-size: 13px;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (max-width: 1023.98px) {
    .actions {
      flex-direction: column;
      gap: 8px;
    }

    .actions :global(.btn) {
      width: 100%;
      min-height: 48px;
      font-size: 16px;
    }
  }
</style>
