---
// Three shapes, chosen in projects.js: 'table', 'single' or 'none' (renders nothing).
const { metrics } = Astro.props;
---

{
  metrics.type === 'table' && (
    <div class="metrics">
      <table class="metrics-table">
        <caption class="visually-hidden">Measured results</caption>
        <thead>
          <tr>
            <th scope="col">Measure</th>
            <th scope="col" class="num">Value</th>
            <th scope="col">Conditions</th>
          </tr>
        </thead>
        <tbody>
          {metrics.rows.map((row) => (
            <tr>
              <th scope="row">{row.measure}</th>
              <td class="num value">{row.value}</td>
              <td class="conditions">{row.conditions}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <dl class="metrics-stack">
        {metrics.rows.map((row) => (
          <div class="stack-row">
            <dt>{row.measure}</dt>
            <dd class="stack-value">{row.value}</dd>
            <dd class="stack-conditions">{row.conditions}</dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

{
  metrics.type === 'single' && (
    <p class="single">
      <span class="single-value">{metrics.value}</span>
      <span class="single-label">{metrics.label}</span>
      <span class="single-conditions">{metrics.conditions}</span>
    </p>
  )
}

<style>
  /* Table: 600px and wider */
  .metrics-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.45;
  }

  .metrics-table th,
  .metrics-table td {
    padding: 8px 12px;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: baseline;
  }

  .metrics-table th:first-child,
  .metrics-table td:first-child {
    padding-left: 0;
  }

  .metrics-table th:last-child,
  .metrics-table td:last-child {
    padding-right: 0;
  }

  .metrics-table thead th {
    padding-top: 6px;
    padding-bottom: 6px;
    font-weight: 600;
    color: var(--muted);
  }

  .metrics-table tbody th {
    font-weight: 400;
  }

  .metrics-table .num {
    text-align: right;
  }

  .value {
    font-size: 20px;
    font-weight: 700;
    font-stretch: 75%;
    color: var(--accent);
    white-space: nowrap;
  }

  .conditions {
    color: var(--muted);
  }

  /* Stacked rows: narrower than 600px. Same data; only one of the two is ever displayed. */
  .metrics-stack {
    display: none;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .stack-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  .stack-row dt {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  .stack-row dd {
    margin: 0;
  }

  .stack-value {
    font-size: 28px;
    line-height: 1.1;
    font-weight: 700;
    font-stretch: 75%;
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .stack-conditions {
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 599.98px) {
    .metrics-table {
      display: none;
    }

    .metrics-stack {
      display: block;
    }
  }

  /* Single number */
  .single {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    margin: 0;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .single-value {
    font-size: 24px;
    line-height: 1.2;
    font-weight: 700;
    font-stretch: 75%;
    color: var(--accent);
  }

  .single-label {
    font-size: 15px;
  }

  .single-conditions {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 599.98px) {
    .single-conditions {
      flex-basis: 100%;
    }
  }
</style>
