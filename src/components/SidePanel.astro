---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { site } from '../data/projects.js';

// home: the name is the page's h1. Elsewhere it is a link back home.
const { home = false, navLabel, navItems } = Astro.props;
const [first, last] = site.name.split(' ');
---

<header class:list={['panel', { 'panel-desktop-only': !home }]}>
  <div class="panel-top">
    {
      home ? (
        <div class="identity">
          <Photo />
          <h1 class="name">{first}<br />{last}</h1>
        </div>
      ) : (
        <a class="identity identity-link" href="/">
          <Photo alt="" />
          <span class="name">{first}<br />{last}</span>
        </a>
      )
    }
    <!-- Phone theme toggle (icon only). theme-toggle.js keeps its aria-label current. -->
    <button type="button" class="theme-toggle-icon js-only" data-theme-toggle aria-label="Switch to dark theme">
      <span data-theme-icon="moon"><Icon name="moon" size={18} /></span>
      <span data-theme-icon="sun" hidden><Icon name="sun" size={18} /></span>
    </button>
  </div>

  <div class="intro">
    <p class="role">{site.role}</p>
    <p class="focus">{site.focus}</p>
  </div>

  <nav class="panel-nav" aria-label={navLabel} data-spy-nav>
    <ul class="nav-list">
      {
        navItems.map((item, i) => (
          <li>
            <a class="nav-link" href={`#${item.id}`} aria-current={i === 0 ? 'true' : undefined}>
              <span class="nav-bar" />
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ul class="links">
    <li>
      <a class="btn btn-ink" href={site.links.resume} target="_blank" rel="noopener">
        <Icon name="resume" />Resume<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </li>
    <li>
      <a class="btn btn-outline" href={site.links.github} target="_blank" rel="noopener">
        <Icon name="github" />GitHub<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </li>
    <li>
      <a class="btn btn-outline" href={site.links.linkedin} target="_blank" rel="noopener">
        <Icon name="linkedin" />LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </li>
    <li>
      <a class="btn btn-outline" href={site.links.email}><Icon name="email" />Email</a>
    </li>
  </ul>

  <!-- Desktop theme toggle. Hidden without JavaScript, since it couldn't do anything. -->
  <button type="button" class="theme-toggle js-only" data-theme-toggle>
    <span data-theme-icon="moon"><Icon name="moon" /></span>
    <span data-theme-icon="sun" hidden><Icon name="sun" /></span>
    <span data-theme-label>Dark theme</span>
  </button>
</header>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .identity {
    display: flex;
    align-items: flex-end;
    gap: 20px;
  }

  .identity-link {
    color: var(--ink);
    text-decoration: none;
  }

  .name {
    margin: 0;
    font-size: 60px;
    line-height: 0.92;
    font-weight: 800;
    font-stretch: 68%;
    letter-spacing: -0.01em;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .intro p {
    margin: 0;
  }

  .role {
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
    font-stretch: 87%;
  }

  .focus {
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
  }

  .nav-list,
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }

  .nav-bar {
    width: 3px;
    height: 18px;
  }

  .nav-link[aria-current='true'] {
    background: var(--tint);
    color: var(--ink);
    font-weight: 700;
  }

  .nav-link[aria-current='true'] .nav-bar {
    background: var(--accent);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .links .btn {
    padding: 0 14px;
  }

  .theme-toggle {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin: -16px 0 0 -12px;
    padding: 0 12px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .panel-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .theme-toggle-icon {
    display: none;
  }

  [data-theme-icon] {
    display: inline-flex;
  }

  /* Phone layout */
  @media (max-width: 1023.98px) {
    /* Project pages use the sticky top bar on phones instead of this panel. */
    .panel-desktop-only {
      display: none;
    }

    .panel {
      /* 88px photo and 48px name at 390px; both shrink a little on narrower screens (or 400% zoom). */
      --photo-size: min(88px, 23vw);
      gap: 20px;
      padding-bottom: 24px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--rule);
    }

    .identity {
      gap: 16px;
    }

    .name {
      font-size: min(48px, 12.5vw);
    }

    .role {
      font-size: 18px;
    }

    .focus {
      font-size: 16px;
    }

    .panel-nav,
    .theme-toggle {
      display: none;
    }

    .theme-toggle-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1.5px solid var(--rule);
      border-radius: 4px;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }

    .links {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .links .btn {
      width: 100%;
      min-height: 48px;
    }
  }
</style>
