---
import Base from '../../layouts/Base.astro';
import SidePanel from '../../components/SidePanel.astro';
import LiveDemo from '../../components/LiveDemo.astro';
import Metrics from '../../components/Metrics.astro';
import Icon from '../../components/Icon.astro';
import StepPlayer from '../../components/StepPlayer.astro';
import BottomNav from '../../components/BottomNav.astro';
import ProjectTopBar from '../../components/ProjectTopBar.astro';
import Showcase from '../../components/Showcase.astro';
import { site, projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;

// The Screens tab only appears for projects with screen recordings (project.showcase).
const tabs = [
  { id: 'write-up', label: 'Write-up', icon: 'writeup' },
  { id: 'how-it-works', label: 'How it works', icon: 'how' },
  ...(project.showcase ? [{ id: 'screens', label: 'Screens', icon: 'screens' }] : []),
];
const parts = [{ id: 'overview', label: 'Overview', icon: 'overview' }, ...tabs];

const writeup = [
  { id: 'problem', heading: 'Problem', text: project.writeup.problem },
  { id: 'approach', heading: 'Approach', text: project.writeup.approach },
  { id: 'results', heading: 'Results', text: project.writeup.results },
  { id: 'change', heading: 'What I’d change', text: project.writeup.change },
];
---

<Base title={`${project.title} | Paul Shenoda`} description={project.summary}>
  <ProjectTopBar slot="top" />
  <SidePanel slot="panel" navLabel="On this page" navItems={parts} />

  <div class="content" data-views tabindex="-1">
    <section id="overview" class="overview">
      <a class="back" href="/#projects"><Icon name="arrow-left" />All projects</a>

      <div class="title">
        <h1>{project.title}</h1>
        <p class="stack">{project.stack}</p>
      </div>

      <div class="tldr">
        <p class="summary">{project.summary}</p>
        <div class="tldr-actions">
          {
            project.liveUrl ? (
              <LiveDemo project={project} variant="primary" />
            ) : (
              <a class="btn btn-primary" href="#screens">See the screens</a>
            )
          }
          <a class="jump" href="#how-it-works">Jump to how it works<Icon name="arrow-down" size={14} /></a>
        </div>
        <p class="demo-note">{project.demoNote}</p>
        <button type="button" class="btn btn-secondary see-how js-only" data-show-view="how-it-works">
          See how it works
        </button>
      </div>

      <Metrics metrics={project.metrics} />
    </section>

    <section class="details" aria-label="Project details">
      <p class="view-context">{project.title}</p>
      <div class="tabs" data-tabs hidden>
        {
          tabs.map((tab) => (
            <button type="button" class="tab" data-tab={tab.id}>
              {tab.label}
            </button>
          ))
        }
      </div>

      <div id="write-up" class="panel-writeup">
        {
          writeup.map((part) => (
            <section id={part.id} class="writeup-part">
              <h2>{part.heading}</h2>
              {part.text.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))
        }
      </div>

      <div id="how-it-works" class="panel-stacked">
        <StepPlayer steps={project.steps} />
      </div>

      {
        project.showcase && (
          <div id="screens" class="panel-stacked">
            <Showcase showcase={project.showcase} />
          </div>
        )
      }
    </section>

    <footer class="page-footer">
      <a class="back" href="/#projects">Back to all projects</a>
      <p>{site.colophon}</p>
    </footer>
  </div>

  <BottomNav slot="bottom" label="Project sections" items={parts} mode="views" />
</Base>

<script>
  import '../../scripts/tabs.js';
  import '../../scripts/step-player.js';
  import '../../scripts/project-views.js';
  import '../../scripts/scroll-spy.js';
</script>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* Focus is moved here when a phone view opens; the view itself is the indicator. */
  .content:focus {
    outline: none;
  }

  .content p {
    margin: 0;
  }

  .overview {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
  }

  .overview .back {
    margin-top: -10px;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h1 {
    font-size: 52px;
    line-height: 1;
    font-weight: 800;
    font-stretch: 70%;
  }

  .stack {
    font-size: 15px;
    color: var(--muted);
  }

  .tldr {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border-radius: 6px;
    background: var(--tint);
  }

  .summary {
    max-width: 60ch;
    font-size: 19px;
    line-height: 1.5;
    font-weight: 500;
  }

  .tldr-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }

  .jump {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
  }

  .demo-note {
    font-size: 13px;
    line-height: 1.4;
    color: var(--muted);
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Tabs */
  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1.5px solid var(--ink);
  }

  .tab {
    min-height: 52px;
    margin-bottom: -1.5px;
    padding: 0 18px;
    border: 0;
    border-radius: 4px 4px 0 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
  }

  .tab[aria-selected='true'] {
    background: var(--tint);
    box-shadow: inset 0 -3px 0 var(--accent);
    color: var(--ink);
    font-weight: 700;
  }

  /* Write-up */
  .panel-writeup {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .writeup-part {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .writeup-part + .writeup-part {
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .writeup-part p {
    max-width: 62ch;
  }

  .page-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .page-footer p {
    max-width: 48ch;
  }

  /* No JavaScript: both panels show, one after the other. */
  .panel-stacked {
    padding-top: 28px;
    border-top: 1.5px solid var(--ink);
  }

  .panel-stacked[role='tabpanel'] {
    padding-top: 0;
    border-top: 0;
  }

  .see-how,
  .view-context {
    display: none;
  }

  /* Phone */
  @media (max-width: 1023.98px) {
    .content {
      gap: 40px;
    }

    .overview {
      gap: 16px;
    }

    .overview .back {
      display: none; /* the sticky top bar has it */
    }

    h1 {
      font-size: 40px;
    }

    .tldr {
      gap: 12px;
      padding: 18px 16px;
    }

    .summary {
      font-size: 17px;
    }

    .tldr-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .tldr-actions :global(.btn) {
      width: 100%;
      min-height: 48px;
      font-size: 16px;
    }

    .jump {
      display: none;
    }

    .see-how {
      display: inline-flex;
      width: 100%;
      min-height: 48px;
      background: transparent;
      font: inherit;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }

    .tabs {
      display: none !important; /* the bottom nav switches panels on phones */
    }

    /* Views (set by project-views.js). Without JavaScript nothing here applies. */
    [data-view='overview'] .details,
    [data-view='details'] .overview {
      display: none;
    }

    [data-view='details'] .view-context {
      display: block;
      font-size: 14px;
      font-weight: 600;
      color: var(--muted);
    }

    .panel-stacked {
      padding-top: 0;
      border-top: 0;
    }

    /* A direct link to a view lands with the project-name label above it still in view. */
    #write-up,
    #how-it-works {
      scroll-margin-top: 40px;
    }
  }
</style>
