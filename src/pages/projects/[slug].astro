---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'rag-document-chatbot' } },
    { params: { slug: 'bible-reading-tracker' } },
    { params: { slug: 'background-job-runner' } },
  ];
}

const { slug } = Astro.params;
---

<Base title={`${slug} | Paul Shenoda`}>
  <h1>{slug}</h1>
  <a href="/#projects">All projects</a>
</Base>
